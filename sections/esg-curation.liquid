<!-- ==========================================================================
     0. NeoLeaf Style Wave Liquid Loader Portal (約 3 秒)
     ========================================================================== -->
<div id="esg-loader-portal" class="esg-loader-portal">
  <div class="esg-neoleaf-loader-box">
    <div class="esg-wave-canvas-wrap">
      <canvas id="esg-neoleaf-wave-canvas"></canvas>
    </div>
    <div class="esg-neoleaf-sub">
      loading... <span id="esg-neoleaf-counter">0</span> %
    </div>
  </div>
</div>

<div class="esg-page">
  <!-- 3D Cosmic Background Starfield Canvas -->
  <div id="esg-webgl-canvas" class="esg-webgl-canvas"></div>

  <!-- ==========================================================================
       1. HERO: 時空交匯 · 零碳古文明策展 & 3D 互動展示台
       ========================================================================== -->
  <section class="esg-hero">
    <div class="esg-container">
      <div class="esg-hero__grid">
        <div class="esg-hero__content">
          <div class="esg-badge esg-badge-gold">
            <span class="morphicon morphicon-gold" style="width: 18px; height: 18px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21h18M3 10h18M5 10v11M9 10v11M15 10v11M19 10v11M12 3l9 7H3l9-7z"/>
              </svg>
            </span>
            <span>Corner Museum × 東方森煌第三方科學鑑定</span>
          </div>

          <h1 class="esg-hero__title esg-serif">
            用累計千年的零碳古物<br>
            為企業寫下永續傳奇
          </h1>

          <p class="esg-hero__subtitle">
            零碳古文明策展計畫 · Zero-Carbon Ancient Civilization Curation
          </p>

          <p class="esg-hero__desc">
            突破傳統 ESG 活動的邊際疲勞。以傳承數百年至數千年的古文明資產，結合第三方光譜科技檢驗，
            打造<strong>「免添購高價資產、零新增碳排、打擊贗品、提升 SROI 評鑑」</strong>的高格局企業永續策展方案。
            一場展覽，最高契合 <strong>7 大聯合國永續發展目標 (UN SDGs)</strong>！
          </p>

          <div class="esg-hero__actions">
            <a href="#esg-contact" class="esg-btn esg-btn-primary">
              <span>立即預約策展方案</span>
              <span class="morphicon" style="width: 18px; height: 18px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
            <a href="#esg-calculator" class="esg-btn esg-btn-outline">
              <span>試算 SROI 效益</span>
            </a>
            <a href="#esg-industries" class="esg-btn esg-btn-outline">
              <span>五大產業跨界扣連</span>
            </a>
          </div>
        </div>

        <!-- Dedicated Corner Museum & ESG Dynamic Interactive Logo Stage -->
        <div class="esg-hero__visual">
          <div class="esg-brand-stage-box" id="esg-brand-stage-box">
            <!-- Top HUD -->
            <div class="esg-brand-hud-top">
              <span class="esg-brand-hud-pill">
                <span class="morphicon morphicon-gold anim-pulse" style="width: 10px; height: 10px; margin-right: 6px;">
                  <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                </span>
                CORNER MUSEUM
              </span>
              <span class="esg-brand-hud-cross">×</span>
              <span class="esg-brand-hud-pill esg-brand-hud-pill--emerald">
                <span class="morphicon morphicon-emerald anim-pulse" style="width: 10px; height: 10px; margin-right: 6px;">
                  <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                </span>
                ZERO-CARBON ESG
              </span>
            </div>

            <!-- Dynamic 3D Perspective Card Container -->
            <div id="esg-brand-card" class="esg-brand-card">
              <!-- Ambient Stardust Particle & Orbit Canvas -->
              <canvas id="esg-brand-canvas" class="esg-brand-canvas"></canvas>

              <!-- Dynamic Dual Logo Display -->
              <div class="esg-brand-duo-wrap">
                <!-- 1. Corner Museum Official Emblem -->
                <div class="esg-brand-unit esg-brand-unit--museum">
                  <div class="esg-brand-medallion esg-brand-medallion--gold">
                    <div class="esg-medallion-halo"></div>
                    <div class="esg-medallion-shimmer"></div>
                    <img 
                      src="{{ 'corner-museum-logo.png' | asset_url }}" 
                      alt="Corner Museum 角落博物館" 
                      class="esg-brand-logo-img"
                      width="160"
                      height="190"
                      loading="eager"
                    >
                  </div>
                  <div class="esg-brand-badge-label">
                    <span class="esg-badge-label-main">Corner Museum</span>
                    <span class="esg-badge-label-sub">東方森煌科學公信</span>
                  </div>
                </div>

                <!-- Energy Convergence Connector -->
                <div class="esg-brand-connector">
                  <div class="esg-connector-pulse"></div>
                  <div class="esg-connector-symbol">×</div>
                  <div class="esg-connector-subtext">英雄相惜</div>
                </div>

                <!-- 2. ESG Dynamic Monogram & Orbiting Pillars -->
                <div class="esg-brand-unit esg-brand-unit--esg">
                  <div class="esg-brand-medallion esg-brand-medallion--emerald">
                    <div class="esg-esg-halo"></div>
                    <div class="esg-esg-orbit-ring">
                      <span class="esg-orbit-pill dot-e" title="Environmental 零新增碳排">E</span>
                      <span class="esg-orbit-pill dot-s" title="Social SROI文化平權">S</span>
                      <span class="esg-orbit-pill dot-g" title="Governance 第三方科學公信">G</span>
                    </div>
                    <div class="esg-esg-emblem-core">
                      <div class="esg-esg-logo-svg-wrap">
                        <svg viewBox="0 0 100 100" class="esg-esg-svg-icon">
                          <defs>
                            <linearGradient id="esgCoreGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                              <stop offset="0%" stop-color="#34d399"/>
                              <stop offset="50%" stop-color="#10b981"/>
                              <stop offset="100%" stop-color="#059669"/>
                            </linearGradient>
                            <linearGradient id="esgGoldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                              <stop offset="0%" stop-color="#fdf2d0"/>
                              <stop offset="50%" stop-color="#c5a059"/>
                              <stop offset="100%" stop-color="#8c6e33"/>
                            </linearGradient>
                          </defs>
                          <!-- Radiant Crest Shape -->
                          <path d="M50 8 C68 24 88 42 88 64 C88 82 71 92 50 92 C29 92 12 82 12 64 C12 42 32 24 50 8 Z" fill="rgba(16, 185, 129, 0.12)" stroke="url(#esgCoreGrad)" stroke-width="2.5"/>
                          <!-- Inner Sprout / Infinity Leaf Branch -->
                          <path d="M50 24 C50 24 64 36 64 52 C64 62 56 68 50 68 C44 68 36 62 36 52 C36 36 50 24 50 24 Z" fill="url(#esgCoreGrad)" opacity="0.85"/>
                          <path d="M50 78 L50 42 M50 56 C56 50 62 52 62 52 M50 62 C44 56 38 58 38 58" stroke="#ffffff" stroke-width="2.8" stroke-linecap="round"/>
                        </svg>
                      </div>
                      <div class="esg-esg-text-mark">ESG</div>
                    </div>
                  </div>
                  <div class="esg-brand-badge-label">
                    <span class="esg-badge-label-main esg-badge-label-main--emerald">零碳古文明策展</span>
                    <span class="esg-badge-label-sub">契合 7 大 UN SDGs</span>
                  </div>
                </div>
              </div>

              <!-- Live Indicator Row -->
              <div class="esg-brand-live-row">
                <span class="esg-brand-live-pill">
                  <span class="esg-dot esg-dot-gold"></span>
                  累計千年零碳文物
                </span>
                <span class="esg-brand-live-pill">
                  <span class="esg-dot esg-dot-emerald"></span>
                  SROI 量化社會價值
                </span>
                <span class="esg-brand-live-pill">
                  <span class="esg-dot esg-dot-gold"></span>
                  100% 科學光譜防偽
                </span>
              </div>
            </div>

            <!-- Bottom HUD -->
            <div class="esg-brand-hud-bottom">
              <div class="esg-brand-hint">
                <span class="morphicon morphicon-gold" style="width: 15px; height: 15px;">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v8M8 12h8"/>
                  </svg>
                </span>
                移動滑鼠 · 探索雙品牌動態共生光場
              </div>
