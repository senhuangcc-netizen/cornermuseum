

<script>
  (function() {
    function checkEsgRoute() {
      var p = (window.location.pathname || '').toLowerCase().replace(/\/+$/, '');
      if (p === '/pages/esg' || p.indexOf('/pages/esg') !== -1 || window.location.href.indexOf('esg') !== -1) {
        document.documentElement.classList.add('is-esg-route');
        if (document.body) document.body.classList.add('is-esg-route');
        document.title = 'cornermuseum_ESG';
      }
    }
    checkEsgRoute();
    document.addEventListener('DOMContentLoaded', checkEsgRoute);
  })();
</script>

<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }

  html.is-esg-route .template-404,
  body.is-esg-route .template-404 {
    display: none !important;
  }

  html:not(.is-esg-route) .section-esg-curation {
    display: none !important;
  }
</style>

<div class="template-404 page-width page-margin center">
  <p>
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  <a href="{{ routes.all_products_collection_url }}" class="button">
    {{ 'general.continue_shopping' | t }}
  </a>
</div>
