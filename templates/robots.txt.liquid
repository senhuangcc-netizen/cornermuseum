{% comment %}
  ==============================================================================
  Corner Museum - robots.txt.liquid
  Enables full indexing for traditional search engines (Google, Bing)
  and modern AI search crawlers (OpenAI GPTBot, PerplexityBot, ClaudeBot, Gemini)
  ==============================================================================
{% endcomment %}
{% for group in robots.default_groups %}
  {{- group.user_agent }}

  {%- for rule in group.rules %}
    {{- rule }}
  {%- endfor %}

  {%- if group.sitemap != blank %}
    {{ group.sitemap }}
  {%- endif %}
{% endfor %}

