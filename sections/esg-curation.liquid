      <!-- 4 Key Stat Odometer Cards -->
      <div class="esg-stats-grid">
        <div class="esg-stat-card">
          <div class="esg-stat-number" style="color: var(--esg-emerald-light);">0 kg</div>
          <div class="esg-stat-label">古物新增碳排</div>
          <div class="esg-stat-desc">完勝裝置藝術或新創藝術</div>
        </div>
        <div class="esg-stat-card">
          <div class="esg-stat-number">85%</div>
          <div class="esg-stat-label">可視覺與數據化產出</div>
          <div class="esg-stat-desc">-策展成果多數得以畫面及數據化</div>
        </div>
        <div class="esg-stat-card">
          <div class="esg-stat-number">7項</div>
          <div class="esg-stat-label">聯合國SDGS指標</div>
          <div class="esg-stat-desc">-一次觸及教育、文化、減碳與健全制度</div>
        </div>
        <div class="esg-stat-card">
          <div class="esg-stat-number" style="color: #c5a059; font-size: clamp(1.8rem, 2.3vw, 2.6rem); letter-spacing: -0.02em;">1: 5.8+ SROI</div>
          <div class="esg-stat-label">社會投資報酬率，多數高於5.8以上</div>
          <div class="esg-stat-desc">-多重效益累加，效益高於一般活動</div>
        </div>
      </div>

      <!-- ======================================================================
           1.5 Enterprise Lobby Curation Showcase (方案 A：企業總部實境策展展示視窗)
           融入深空琉金 HUD 取景框、科技定位角碼、動態光流、熱點探索與 3D 視差
           ====================================================================== -->
      <div class="esg-showcase-wrap" id="esg-showcase-wrap">
        <div class="esg-showcase-ambient-halo"></div>

        <div class="esg-showcase-card" id="esg-showcase-card">
          <!-- 4 Cyber-Museum Corner Reticles (科技文博四角定位瞄準碼) -->
          <div class="esg-reticle reticle-tl"></div>
          <div class="esg-reticle reticle-tr"></div>
          <div class="esg-reticle reticle-bl"></div>
          <div class="esg-reticle reticle-br"></div>

          <!-- Top HUD Status Bar -->
