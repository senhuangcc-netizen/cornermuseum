</style>

<script>
  (function() {
    // 1. 書籤收藏系統 (Local Storage)
    var BOOKMARKS_KEY = 'cornermuseum_insights_bookmarks';

    function getBookmarks() {
      try {
        var data = localStorage.getItem(BOOKMARKS_KEY);
        return data ? JSON.parse(data) : [];
      } catch(e) {
        return [];
      }
    }

    function toggleBookmark(id) {
      if (!id) return;
      var strId = String(id);
      var bookmarks = getBookmarks();
      var idx = bookmarks.indexOf(strId);
      if (idx > -1) {
        bookmarks.splice(idx, 1);
      } else {
        bookmarks.push(strId);
      }
      try {
        localStorage.setItem(BOOKMARKS_KEY, JSON.stringify(bookmarks));
      } catch(e) {}
      updateBookmarkUI();
      if (currentFilter === 'bookmarks') {
        applyFilterAndSearch();
      }
    }

    function updateBookmarkUI() {
      var bookmarks = getBookmarks();
      var countEl = document.getElementById('count-bookmarks');
      if (countEl) countEl.textContent = bookmarks.length;

      document.querySelectorAll('.insights-bookmark-btn').forEach(function(btn) {
        var id = String(btn.getAttribute('data-id') || '');
        if (bookmarks.indexOf(id) > -1) {
          btn.classList.add('bookmarked');
          btn.setAttribute('title', '已收藏 (點擊取消)');
        } else {
          btn.classList.remove('bookmarked');
          btn.setAttribute('title', '收藏至我的典藏');
        }
      });
    }

    // 2. 分類篩選、搜尋與排序邏輯
    var currentFilter = 'all';
    var currentSearch = '';
    var currentSort = 'newest';

    function getAllArticleCards() {
      var featuredCard = document.querySelector('.insights-featured-card');
      var gridCards = Array.from(document.querySelectorAll('.insights-article-card'));
      var all = [];
      if (featuredCard) all.push(featuredCard);
      return all.concat(gridCards);
    }

    function applyFilterAndSearch() {
      var allCards = getAllArticleCards();
      var bookmarks = getBookmarks();
      var visibleCount = 0;

      allCards.forEach(function(card) {
        var cardId = String(card.getAttribute('data-article-id') || '');
        var cardTitle = (card.getAttribute('data-title') || '').toLowerCase();
        var cardAuthor = (card.getAttribute('data-author') || '').toLowerCase();
        var cardExcerpt = (card.getAttribute('data-excerpt') || '').toLowerCase();
        var cardTags = (card.getAttribute('data-tags') || '').toLowerCase();

        // 分類過濾
        var matchCategory = false;
        if (currentFilter === 'all') {
          matchCategory = true;
        } else if (currentFilter === 'bookmarks') {
          matchCategory = (bookmarks.indexOf(cardId) > -1);
        } else {
          var targetTag = currentFilter.toLowerCase();
          matchCategory = (cardTags.indexOf(targetTag) > -1);
        }

        // 搜尋過濾 (比對標題、作者、內文摘要、標籤)
        var matchSearch = true;
        if (currentSearch) {
          var s = currentSearch;
          matchSearch = (
            cardTitle.indexOf(s) > -1 ||
            cardAuthor.indexOf(s) > -1 ||
            cardExcerpt.indexOf(s) > -1 ||
            cardTags.indexOf(s) > -1
          );
        }

        var isVisible = matchCategory && matchSearch;
        var isFeatured = card.classList.contains('insights-featured-card');

        if (isVisible) {
          card.style.display = isFeatured ? 'grid' : 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // 更新計數顯示
      var counterEl = document.getElementById('visibleArticlesCount');
      if (counterEl) counterEl.textContent = visibleCount;

      var noResultsEl = document.getElementById('insightsNoResults');
      if (noResultsEl) {
        noResultsEl.style.display = (visibleCount === 0 && allCards.length > 0) ? 'block' : 'none';
      }
    }

    function sortArticles(sortType) {
      var grid = document.getElementById('insightsArticlesGrid');
      if (!grid) return;
      var cards = Array.from(grid.querySelectorAll('.insights-article-card'));

      cards.sort(function(a, b) {
        var dateA = a.getAttribute('data-date') || '';
        var dateB = b.getAttribute('data-date') || '';
        var titleA = a.getAttribute('data-title') || '';
        var titleB = b.getAttribute('data-title') || '';

        if (sortType === 'newest') {
          return dateB.localeCompare(dateA);
        } else if (sortType === 'oldest') {
          return dateA.localeCompare(dateB);
        } else if (sortType === 'title') {
          return titleA.localeCompare(titleB);
        }
        return 0;
      });

      cards.forEach(function(c) {
        grid.appendChild(c);
      });
    }

    function updatePillCounts() {
      var allCards = getAllArticleCards();
      var tagCounts = {};

      allCards.forEach(function(c) {
        var rawTags = c.getAttribute('data-tags') || '';
        if (rawTags) {
          var splitTags = rawTags.split(',').map(function(t) { return t.trim().toLowerCase(); }).filter(Boolean);
          splitTags.forEach(function(st) {
            tagCounts[st] = (tagCounts[st] || 0) + 1;
          });
        }
      });

      // 更新全部文章數量
      var allCountEl = document.getElementById('count-all');
      if (allCountEl) allCountEl.textContent = allCards.length;

      // 更新每個標籤 Pill 的計數
      document.querySelectorAll('.insights-filter-pill[data-filter]').forEach(function(pill) {
        var filterVal = pill.getAttribute('data-filter');
        if (filterVal && filterVal !== 'all' && filterVal !== 'bookmarks') {
          var countSpan = pill.querySelector('.pill-count');
          if (countSpan) {
            countSpan.textContent = tagCounts[filterVal.toLowerCase()] || 0;
          }
        }
      });
    }

    // 3. 事件綁定初始化
    document.addEventListener('DOMContentLoaded', function() {
      updatePillCounts();
      updateBookmarkUI();
      applyFilterAndSearch();

      // 分類標籤點擊切換
      var filterBtns = document.querySelectorAll('.insights-filter-pill');
      filterBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          filterBtns.forEach(function(b) { b.classList.remove('active'); });
          this.classList.add('active');
          currentFilter = this.getAttribute('data-filter') || 'all';
          applyFilterAndSearch();
        });
      });

      // 搜尋框輸入即時監聽
      var searchInput = document.getElementById('insightsSearchInput');
      var searchClear = document.getElementById('insightsSearchClear');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          currentSearch = this.value.trim().toLowerCase();
          if (searchClear) searchClear.style.display = currentSearch ? 'block' : 'none';
          applyFilterAndSearch();
        });
      }
      if (searchClear) {
        searchClear.addEventListener('click', function() {
          if (searchInput) searchInput.value = '';
          currentSearch = '';
          searchClear.style.display = 'none';
          applyFilterAndSearch();
        });
      }

      // 排序選單切換
      var sortSelect = document.getElementById('insightsSortSelect');
      if (sortSelect) {
        sortSelect.addEventListener('change', function() {
          currentSort = this.value;
          sortArticles(currentSort);
        });
      }

      // 點擊收藏按鈕 (委派處理)
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.insights-bookmark-btn');
        if (btn) {
          e.preventDefault();
          e.stopPropagation();
          var id = btn.getAttribute('data-id');
          if (id) toggleBookmark(id);
        }
      });

      // 快速導讀按鈕點擊 (讀取真實卡片資料注入 Modal)
      document.addEventListener('click', function(e) {
        var quickBtn = e.target.closest('.insights-quick-read-btn, .insights-card-quick-btn');
        if (quickBtn) {
          e.preventDefault();
          var t = quickBtn.getAttribute('data-quick-title') || '專欄導讀';
          var a = quickBtn.getAttribute('data-quick-author') || 'Corner Museum';
          var d = quickBtn.getAttribute('data-quick-date') || '';
          var ex = quickBtn.getAttribute('data-quick-excerpt') || '';
          var u = quickBtn.getAttribute('data-quick-url') || '';
          openQuickModal(t, a, d, ex, u);
        }
      });

      // ESC 鍵關閉彈窗
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeQuickModal();
      });
    });

    // 4. 全域速讀彈窗操作函數 (動態灌入真實文章內容)
    window.openQuickModal = function(title, author, date, excerpt, url) {
      var modal = document.getElementById('insightsQuickModal');
      if (!modal) return;
      var titleEl = document.getElementById('modalTitle');
      var authorEl = document.getElementById('modalAuthor');
      var dateEl = document.getElementById('modalDate');
      var excerptEl = document.getElementById('modalExcerpt');
      var fullLinkEl = document.getElementById('modalFullLink');

      if (titleEl) titleEl.textContent = title;
      if (authorEl) authorEl.textContent = author;
      if (dateEl) dateEl.textContent = date;
      if (excerptEl) excerptEl.textContent = excerpt || '無摘要說明';
      if (fullLinkEl) {
        fullLinkEl.href = url || 'javascript:void(0);';
        fullLinkEl.style.display = url ? 'inline-flex' : 'none';
      }

      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    };

    window.closeQuickModal = function(e) {
      var modal = document.getElementById('insightsQuickModal');
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    };

    window.resetAllFilters = function() {
      var searchInput = document.getElementById('insightsSearchInput');
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      var searchClear = document.getElementById('insightsSearchClear');
      if (searchClear) searchClear.style.display = 'none';

      var allPill = document.querySelector('.insights-filter-pill[data-filter="all"]');
      if (allPill) {
        document.querySelectorAll('.insights-filter-pill').forEach(function(b) { b.classList.remove('active'); });
        allPill.classList.add('active');
        currentFilter = 'all';
      }
      applyFilterAndSearch();
    };
  })();
</script>

