{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .exhibition-gallery__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .exhibition-gallery__subtitle {
    font-size: 1.3rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #C5A059;
    margin-bottom: 0.8rem;
    display: block;
  }

  .exhibition-gallery__title {
    text-align: center;
    margin: 0;
    font-family: var(--font-heading-family), 'Playfair Display', serif;
    letter-spacing: 0.04em;
  }

  .exhibition-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .exhibition-gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .exhibition-gallery__item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 6px;
    border: 1px solid rgba(197, 160, 89, 0.22);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
    background: #070d12;
  }

  .exhibition-gallery__item:hover {
    transform: translateY(-6px);
    border-color: #C5A059;
    box-shadow: 0 14px 32px rgba(197, 160, 89, 0.22);
  }

  .exhibition-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .exhibition-gallery__item:hover img {
    transform: scale(1.06);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="exhibition-gallery__header">
      {%- if section.settings.subtitle != blank -%}
        <span class="exhibition-gallery__subtitle">{{ section.settings.subtitle }}</span>
      {%- else -%}
        <span class="exhibition-gallery__subtitle">典藏盛事 · ARCHIVAL MOMENTS</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="exhibition-gallery__title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
    </div>

    <div class="exhibition-gallery">
      {%- for block in section.blocks -%}
        <div class="exhibition-gallery__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: 'calc(100vw / 3)', widths: '400, 600, 800, 1000' }}
          {%- elsif block.settings.asset_image_name != blank -%}
            <img src="{{ block.settings.asset_image_name | asset_url }}" loading="lazy" width="800" height="800" alt="Corner Museum 展覽盛事回顧">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Exhibition Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "default": "典藏盛事 · ARCHIVAL MOMENTS",
      "label": "Subtitle"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Exhibition Highlights",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra Large"
        }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset_image_name",
          "label": "Asset Image Name (e.g. exhibition-1.jpg)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Exhibition Gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
