              <span class="esg-pill-divider">·</span>
              <span class="esg-pill-sub">7 SDGs</span>
              <span class="esg-pill-divider">·</span>
              <span class="esg-pill-sub esg-gold-text">SROI 1: 5.8+</span>
            </div>
          </div>

          <!-- Visual Canvas Stage with Interactive Image -->
          <div class="esg-showcase-viewport">
            <img
              src="{{ 'esg-popup-ad.jpg' | asset_url }}"
              alt="Corner Museum 零碳古文明策展 - 企業總部大廳實境展示"
              class="esg-showcase-img"
              id="esg-showcase-img"
              loading="eager"
              width="1200"
              height="397"
            >

            <!-- Holographic Light Sheen & Scanlines -->
            <div class="esg-showcase-scanlines"></div>
            <div class="esg-showcase-shimmer"></div>

            <!-- Hotspot 1: Left Showcase (XRF 科學光譜履歷) -->
            <div class="esg-hotspot hotspot-xrf" style="left: 45.8%; top: 46%;">
              <div class="esg-hotspot-pin" tabindex="0" role="button" aria-label="SDG 9 東方森煌 XRF 光譜履歷">
                <span class="esg-pin-pulse"></span>
                <span class="esg-pin-core">
                  <span class="esg-pin-dot"></span>
                </span>
              </div>
              <div class="esg-hotspot-tooltip">
                <div class="esg-tooltip-header">
                  <span class="esg-tooltip-badge esg-badge--emerald">SDG 9 · 科技研發</span>
                  <strong>東方森煌 XRF 光譜履歷</strong>
                </div>
                <p class="esg-tooltip-desc">
                  拉曼光譜與無機元素定量分析，古物具備 100% 客觀科學履歷，徹底杜絕贗品爭議。
                </p>
              </div>
            </div>

            <!-- Hotspot 2: Right Showcase (微氣候恆溫恆濕展櫃) -->
            <div class="esg-hotspot hotspot-climate" style="left: 58.2%; top: 46%;">
              <div class="esg-hotspot-pin" tabindex="0" role="button" aria-label="SDG 11 博物館級氣候微環境">
                <span class="esg-pin-pulse"></span>
                <span class="esg-pin-core">
                  <span class="esg-pin-dot"></span>
                </span>
              </div>
              <div class="esg-hotspot-tooltip">
                <div class="esg-tooltip-header">
                  <span class="esg-tooltip-badge esg-badge--emerald">SDG 11 · 文化資產</span>
                  <strong>博物館級微氣候展櫃</strong>
                </div>
                <p class="esg-tooltip-desc">
                  氣密恆溫恆濕展櫃（RH 45%~55%），高額古物免買斷借展，企業零負擔進駐大廳。
                </p>
              </div>
            </div>

            <!-- Hotspot 3: Executive Dialogue (英雄相惜 永續對話) -->
            <div class="esg-hotspot hotspot-dialogue" style="left: 64.6%; top: 38.5%;">
              <div class="esg-hotspot-pin" tabindex="0" role="button" aria-label="SDG 17 英雄相惜跨界對話">
                <span class="esg-pin-pulse"></span>
                <span class="esg-pin-core">
                  <span class="esg-pin-dot"></span>
                </span>
              </div>
              <div class="esg-hotspot-tooltip">
                <div class="esg-tooltip-header">
                  <span class="esg-tooltip-badge esg-badge--gold">SDG 17 · 夥伴關係</span>
                  <strong>英雄相惜 · 永續對話</strong>
                </div>
                <p class="esg-tooltip-desc">
                  以千年古文明為載體，為企業量身打造高格局 SROI 社會投資回報，補齊文化永續指標。
                </p>
              </div>
            </div>
          </div>

          <!-- Bottom HUD Footer -->
          <div class="esg-showcase-hud-bottom">
            <div class="esg-showcase-caption">
              <span class="esg-caption-star">✦</span>
              <span class="esg-caption-text">
                用累計千年的零碳文物，幫你寫下英雄相惜的永續故事
              </span>
            </div>
            <div class="esg-showcase-hint">
              <span class="esg-hint-pulse"></span>
              <span>懸停或點選探索互動熱點 · Hover to explore</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

