<!-- 2. Dynamic BreadcrumbList Schema (SEO Hierarchy in Search Results) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首頁",
      "item": "{{ shop.url }}"
    }
    {%- if request.path contains 'esg' or canonical_url contains 'esg' or template.suffix == 'esg' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "cornermuseum_ESG 零碳古文明策展",
        "item": "{{ canonical_url }}"
      }
    {%- elsif request.path contains 'insights' or canonical_url contains 'insights' or request.path contains 'blogs' or template.name == 'blog' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "名家洞察 · 藏界專欄",
        "item": "{{ canonical_url }}"
      }
    {%- elsif request.page_type == 'collection' and collection.handle -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}/collections/{{ collection.handle }}"
      }
    {%- elsif request.page_type == 'product' -%}
      {%- if collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": "{{ shop.url }}/collections/{{ collection.handle }}"
        }
        ,{
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": "{{ canonical_url }}"
        }
      {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": "{{ canonical_url }}"
        }
      {%- endif -%}
    {%- elsif request.page_type == 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | default: "名家洞察" | json }},
        "item": "{{ shop.url }}/blogs/{{ blog.handle }}"
      }
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": "{{ canonical_url }}"
      }
    {%- elsif request.page_type == 'page' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": "{{ canonical_url }}"
      }
    {%- endif -%}
  ]
}
</script>

<!-- 3. AEO (Answer Engine Optimization) & GEO FAQPage Schema -->
{%- if request.path contains 'esg' or canonical_url contains 'esg' or template.suffix == 'esg' or request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "{{ shop.url }}/#faq-esg",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "什麼是「零碳古文明策展計畫」？與傳統企業 ESG 活動有何不同？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "零碳古文明策展是以傳承數百年至千年之歷史古物為展覽核心，天然無新增製造碳排放，兼顧文化平權與永續報告書 SROI 實質量化效益之企業綠色展覽。相較於傳統展覽產生數噸木作與一次性塑膠垃圾，本計畫創造 0 kg 新增製造碳排，並透過第三方科學光譜驗證，賦予企業永續報告最高公信力。"
      }
    },
    {
      "@type": "Question",
      "name": "古文明策展如何具體契合聯合國 7 大永續發展目標 (UN SDGs)？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "本計畫一次涵蓋 7 大聯合國指標：SDG 4 優質教育（校園與員工科普講座）、SDG 8 尊嚴就業與經濟成長、SDG 9 產業創新與科學光譜應用、SDG 11 永續城市與文化資產保存、SDG 12 責任消費與零廢棄展陳、SDG 13 氣候行動（零新增碳排）、以及 SDG 17 多元夥伴關係（跨界產學與文博合作）。"
      }
    },
    {
      "@type": "Question",
      "name": "企業策展的 SROI（社會投資報酬率）如何量化與提供第三方審計確信？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "依據國際 SROI 評估架構與財務代理定價（Financial Proxies），量化文化教育、古蹟資產普及與防偽減碳價值，平均預估每投入 NT$ 1 預算可創造 NT$ 5.8+ 社會影響力價值（SROI 1: 5.8+）。Corner Museum 提供完整量化數據、問卷樣本與效益稽核憑證，便於企業於 ESG 永續報告書中接受會計師事務所確信查核。"
      }
    },
    {
      "@type": "Question",
      "name": "什麼是東方森煌「第三方科學光譜鑑定」？拉曼光譜與 XRF 如何防偽？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "東方森煌採用「拉曼光譜（Raman Spectroscopy）」分析玉石器物表層風化結晶之分子振動指紋，結合「X射線螢光光譜（XRF）」無損定量分析陶瓷釉層元素比例，比對歷代考古基準資料庫，杜絕人為做舊贗品，確保企業策展 100% 真品無爭議，根絕公關危機。"
      }
    },
    {
      "@type": "Question",
      "name": "企業每年 ESG 預算浮動，若預算僅數十萬元，適合長期合作嗎？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "非常適合。Corner Museum 推出彈性預算階梯方案，策展規劃最低只要 NT$ 390,000 起。珍貴古代文物均免收高昂借展費，預算純粹用於專題策劃、科技展陳、安全維護與永續指標量化分析，無論中大型跨國集團或在地標竿企業皆能輕鬆導入。"
      }
    },
    {
      "@type": "Question",
      "name": "展出期間古文物的安全性、微環境溫濕度與保險如何規範？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "所有展品均配置博物館級氣密恆溫恆濕微環境專業展櫃、防震底座與 24 小時動態感測，並為每批借展文物投保國際級「藝術品綜合保險（All Risks Fine Arts Insurance）」，由專業護衛與策展人員全程監管，確保企業展場安全達到國家級博物館展陳標準。"
      }
    }
  ]
}
</script>
{%- endif -%}

